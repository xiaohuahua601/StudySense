# 复制本文件为 .env 并填写（.env 已被 .gitignore 排除, 不会上传）
MYSQL_PASSWORD=你的MySQL密码
OLLAMA_MODEL=qwen2.5:7b

# ---- 仪表盘独立部署（可选, 不填则用默认值） ----
# 大屏页面访问后端 API 的地址: 本机测试保持默认; 部署到班级大屏时改为服务器实际地址
DASHBOARD_API_BASE=http://localhost:8000
# 后端 CORS 跨域白名单(允许访问 API 的大屏页面来源), 多个用逗号分隔
# 例如大屏机器 IP 为 192.168.1.60: http://localhost:8080,http://192.168.1.60:8080
CORS_ORIGINS=http://localhost:8080

